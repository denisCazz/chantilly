---
import { Icon } from 'astro-icon/components';
---

<section id="home" class="hero">
	<div class="hero-container">
		<div class="hero-content">
			<div class="hero-badge">
				<Icon name="mdi:map-marker" />
				<span>Carmagnola, TO</span>
			</div>
			<h1 class="hero-title">
				Bar Tabacchi <span class="highlight">Chantilly</span>
			</h1>
			<p class="hero-subtitle">
				Il tuo punto di riferimento nel cuore di Carmagnola. Colazioni, aperitivi, tabacchi e molto altro in un ambiente accogliente e familiare.
			</p>
			<div class="hero-buttons">
				<a href="/menu/" class="btn btn-primary">
					<Icon name="mdi:coffee-outline" />
					Scopri il Menu
				</a>
				<a href="#contatti" class="btn btn-secondary">
					<Icon name="mdi:phone" />
					Contattaci
				</a>
			</div>
			<div class="hero-features">
				<div class="hero-feature">
					<Icon name="mdi:clock-outline" />
					<span>Aperti 7 giorni</span>
				</div>
				<div class="hero-feature">
					<Icon name="mdi:coffee" />
					<span>Caffè di qualità</span>
				</div>
				<div class="hero-feature">
					<Icon name="mdi:heart" />
					<span>Dal 1988</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 85vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 12rem 2rem 6rem;
		background: var(--color-background);
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: 
			radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.08) 0%, transparent 50%),
			radial-gradient(circle at 80% 50%, rgba(76, 175, 80, 0.06) 0%, transparent 50%);
		z-index: 1;
	}

	[data-theme="dark"] .hero {
		background: var(--color-background);
	}

	[data-theme="dark"] .hero::before {
		background: 
			radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
			radial-gradient(circle at 80% 50%, rgba(76, 175, 80, 0.03) 0%, transparent 50%);
	}

	.hero-container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.hero-content {
		text-align: center;
		max-width: 900px;
		margin: 0 auto;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1.25rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--border-radius-full);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		margin-bottom: 2rem;
		box-shadow: var(--shadow-sm);
	}

	[data-theme="dark"] .hero-badge {
		background: var(--color-surface-alt);
		border-color: var(--color-border);
	}

	.hero-badge [data-icon] {
		color: var(--color-secondary);
		font-size: 1.1rem;
	}

	.hero-title {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 800;
		margin-bottom: 1.5rem;
		line-height: 1.1;
		color: var(--color-text-primary);
		letter-spacing: -0.02em;
	}

	.hero-title .highlight {
		color: var(--color-secondary);
		display: inline-block;
		position: relative;
	}

	.hero-subtitle {
		font-size: clamp(1.1rem, 2.2vw, 1.3rem);
		max-width: 700px;
		margin: 0 auto 3rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
		font-weight: 400;
	}

	.hero-buttons {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
		margin-bottom: 4rem;
	}

	.hero-features {
		display: flex;
		justify-content: center;
		gap: 3rem;
		flex-wrap: wrap;
		padding-top: 3rem;
		border-top: 1px solid var(--color-border);
	}

	.hero-feature {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-text-secondary);
		font-size: 0.95rem;
		font-weight: 500;
	}

	.hero-feature [data-icon] {
		color: var(--color-secondary);
		font-size: 1.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.85rem 2rem;
		border-radius: var(--border-radius-full);
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
		box-shadow: var(--shadow-sm);
	}

	.btn:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--color-secondary) 0%, #c19c2f 100%);
		color: var(--color-white);
		border: 2px solid transparent;
		box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
	}

	.btn-primary:hover {
		background: linear-gradient(135deg, #c19c2f 0%, var(--color-secondary) 100%);
		box-shadow: 0 12px 32px rgba(212, 175, 55, 0.4);
		transform: translateY(-4px);
	}

	.btn-secondary {
		background: var(--color-background);
		backdrop-filter: blur(10px);
		color: var(--color-text-primary);
		border: 2px solid var(--color-border-strong);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
	}

	.btn-secondary:hover {
		background: var(--color-surface);
		border-color: var(--color-secondary);
		box-shadow: 0 8px 24px rgba(212, 175, 55, 0.2);
		transform: translateY(-4px);
		color: var(--color-text-primary);
	}

	[data-theme="dark"] .btn-secondary {
		background: var(--color-surface-alt);
		border-color: var(--color-border);
		color: var(--color-text-primary);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}

	[data-theme="dark"] .btn-secondary:hover {
		background: var(--color-surface-muted);
		border-color: var(--color-secondary);
		color: var(--color-text-primary);
		box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-15px);
		}
	}

	@keyframes floatRotated {
		0%,
		100% {
			transform: rotate(-25deg) translateY(0);
		}
		50% {
			transform: rotate(-25deg) translateY(-15px);
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 10rem 1.5rem 4rem;
			min-height: 75vh;
		}

		.hero-badge {
			margin-bottom: 1.5rem;
			font-size: 0.85rem;
		}

		.hero-title {
			margin-bottom: 1rem;
		}

		.hero-subtitle {
			margin-bottom: 2rem;
		}

		.hero-buttons {
			flex-direction: column;
			width: 100%;
			margin-bottom: 3rem;
		}

		.btn {
			width: 100%;
			justify-content: center;
		}

		.hero-features {
			gap: 2rem;
			padding-top: 2rem;
		}

		.hero-feature {
			font-size: 0.9rem;
		}
	}
</style>
