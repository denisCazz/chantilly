---
---

<section id="orari" class="hours section">
	<div class="container">
		<h2 class="section-title">I Nostri Orari</h2>
		<p class="section-subtitle">
			Siamo aperti dalle 7:00 alle 22:00 con orario continuato, tranne il mercoledì.
		</p>
		
		<!-- Indicatore Aperto/Chiuso -->
		<div class="status-badge" id="status-badge">
			<span class="status-icon" id="status-icon"></span>
			<span class="status-text" id="status-text">Caricamento...</span>
		</div>
		
		<div class="hours-content">
			<div class="hours-table-wrapper">
				<div class="hours-table">
					<div class="hours-row">
						<span class="day">Lunedì</span>
						<span class="time">07:00 - 22:00</span>
					</div>
					<div class="hours-row">
						<span class="day">Martedì</span>
						<span class="time">07:00 - 22:00</span>
					</div>
					<div class="hours-row closed">
						<span class="day">Mercoledì</span>
						<span class="time">Giorno di chiusura</span>
					</div>
					<div class="hours-row">
						<span class="day">Giovedì</span>
						<span class="time">07:00 - 22:00</span>
					</div>
					<div class="hours-row">
						<span class="day">Venerdì</span>
						<span class="time">07:00 - 22:00</span>
					</div>
					<div class="hours-row">
						<span class="day">Sabato</span>
						<span class="time">07:00 - 22:00</span>
					</div>
					<div class="hours-row">
						<span class="day">Domenica</span>
						<span class="time">07:00 - 22:00</span>
					</div>
				</div>
			</div>
			
			<div class="hours-info">
				<div class="info-card">
					<div class="info-icon">
						<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-clock-hour-8" width="44" height="44" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
							<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
							<path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
							<path d="M12 12l-3.5 2" />
							<path d="M12 7v5" />
						</svg>
					</div>
					<h3>Orario Continuato</h3>
					<p>Siamo aperti senza interruzioni dal lunedì alla domenica per garantirti la massima comodità. Solo il Mercoledì siamo chiusi.</p>
				</div>
				
				<div class="info-card">
					<div class="info-icon">
						<svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-calendar-event" width="44" height="44" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
							<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
							<path d="M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" />
							<path d="M16 3l0 4" />
							<path d="M8 3l0 4" />
							<path d="M4 11l16 0" />
							<path d="M8 15h2v2h-2z" />
						</svg>
					</div>
					<h3>Orari Festivi</h3>
					<p>Durante le festività, gli orari potrebbero subire variazioni. Contattaci per maggiori dettagli.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const statusBadge = document.getElementById('status-badge');
		const statusIcon = document.getElementById('status-icon');
		const statusText = document.getElementById('status-text');
		
		if (!statusBadge || !statusIcon || !statusText) return;
		
		function checkStatus() {
			const badge = statusBadge!;
			const text = statusText!;
			const now = new Date();
			const day = now.getDay(); // 0 = Domenica, 1 = Lunedì, ..., 6 = Sabato
			const hour = now.getHours();
			const minute = now.getMinutes();
			const currentTime = hour * 60 + minute;
			const openTime = 7 * 60; // 07:00
			const closeTime = 22 * 60; // 22:00
			
			// Mercoledì = giorno 3, chiuso
			if (day === 3) {
				badge.className = 'status-badge closed';
				text.textContent = 'Oggi siamo chiusi';
				return;
			}
			
			// Controlla se siamo aperti
			if (currentTime >= openTime && currentTime < closeTime) {
				badge.className = 'status-badge open';
				text.textContent = 'Siamo aperti ora';
				
				// Calcola quando chiudiamo
				const minutesUntilClose = closeTime - currentTime;
				const hoursUntilClose = Math.floor(minutesUntilClose / 60);
				const minsUntilClose = minutesUntilClose % 60;
				
				if (hoursUntilClose > 0) {
					text.textContent += ` • Chiudiamo tra ${hoursUntilClose}h ${minsUntilClose > 0 ? minsUntilClose + 'min' : ''}`;
				} else {
					text.textContent += ` • Chiudiamo tra ${minsUntilClose} minuti`;
				}
			} else {
				badge.className = 'status-badge closed';
				if (currentTime < openTime) {
					text.textContent = 'Siamo chiusi • Apriamo alle 07:00';
				} else {
					text.textContent = 'Siamo chiusi • Apriamo domani alle 07:00';
				}
			}
		}
		
		checkStatus();
		// Aggiorna ogni minuto
		setInterval(checkStatus, 60000);
	});
</script>

<style>
	.hours {
		background: var(--color-background);
		padding: 7rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	[data-theme="dark"] .hours {
		background: var(--color-surface);
	}

	.hours-content {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: start;
		margin-top: 3rem;
	}

	.hours-table-wrapper {
		background: var(--color-surface-muted);
		border: 1px solid var(--color-border);
		border-radius: var(--border-radius-lg);
		padding: 2rem;
		box-shadow: var(--shadow-md);
	}

	[data-theme="dark"] .hours-table-wrapper {
		background: var(--color-surface);
		border-color: var(--color-border-dark);
	}

	.hours-table {
		width: 100%;
	}

	.hours-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border-light);
		transition: var(--transition);
	}

	.hours-row:last-child {
		border-bottom: none;
	}

	.hours-row:hover {
		background-color: var(--color-highlight);
	}
	
	[data-theme="dark"] .hours-row:hover {
		background-color: var(--color-surface-alt);
	}

	.day {
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.time {
		font-family: var(--font-mono);
		color: var(--color-text-secondary);
		font-weight: 600;
	}

	.hours-row.closed .day,
	.hours-row.closed .time {
		color: var(--color-text-disabled);
		text-decoration: line-through;
	}

	.hours-row.closed .time {
		text-decoration: none;
		font-style: italic;
	}

	/* Status Badge */
	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.5rem;
		margin: 2rem auto 0;
		border-radius: var(--border-radius-full);
		font-weight: 600;
		font-size: 1.1rem;
		box-shadow: var(--shadow-md);
		transition: all 0.3s ease;
		justify-content: center;
		max-width: fit-content;
	}

	.status-badge.open {
		background: linear-gradient(135deg, #4caf50, #66bb6a);
		color: white;
		border: 2px solid #2e7d32;
	}

	.status-badge.closed {
		background: linear-gradient(135deg, #f44336, #e57373);
		color: white;
		border: 2px solid #c62828;
	}

	.status-icon {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: currentColor;
		animation: pulse 2s infinite;
		box-shadow: 0 0 0 0 currentColor;
	}

	.status-badge.closed .status-icon {
		animation: none;
	}

	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 currentColor;
		}
		70% {
			box-shadow: 0 0 0 10px rgba(255, 255, 255, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
		}
	}

	.hours-info {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.info-card {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		background: var(--color-surface-muted);
		padding: 1.5rem;
		border-radius: var(--border-radius-lg);
		border: 1px solid var(--color-border);
	}

	[data-theme="dark"] .info-card {
		background: var(--color-surface-alt);
		border-color: var(--color-border-dark);
	}

	.info-icon {
		color: var(--color-secondary);
		flex-shrink: 0;
	}
	
	.info-icon svg {
		width: 32px;
		height: 32px;
	}

	.info-card h3 {
		font-size: 1.1rem;
		color: var(--color-text-primary);
		margin-bottom: 0.3rem;
		font-weight: 600;
	}

	.info-card p {
		font-size: 0.9rem;
		color: var(--color-text-secondary);
		line-height: 1.5;
		margin: 0;
	}

	@media (max-width: 992px) {
		.hours-content {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}

	@media (max-width: 768px) {
		.hours {
			padding: 4rem 0;
		}
		.hours-table-wrapper {
			padding: 1.5rem;
		}
		.info-card {
			flex-direction: column;
			text-align: center;
			gap: 1rem;
		}
	}
</style>
