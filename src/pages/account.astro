---
import Layout from '../layouts/Layout.astro';
import AuthGate from '../components/loyalty/AuthGate';
import CustomerCard from '../components/loyalty/CustomerCard';
---

<Layout title="Il Tuo Profilo | Bar Chantilly">
  <main class="account-page">
    <div class="container">
      <h1 class="page-title">Il Tuo Profilo</h1>
      <AuthGate client:load>
        <CustomerCard client:load />
      </AuthGate>
    </div>
  </main>
</Layout>

<script>
  // Redirect automatico per admin/staff
  if (typeof window !== 'undefined') {
    import('../lib/supabaseClient.js').then(({ supabase, isSupabaseConfigured }) => {
      if (isSupabaseConfigured()) {
        supabase.auth.getSession().then(({ data: { session } }) => {
          if (session?.user) {
            // Controlla il ruolo
            supabase
              .from('profiles')
              .select('role')
              .eq('id', session.user.id)
              .single()
              .then(({ data, error }) => {
                if (!error && data && (data.role === 'admin' || data.role === 'staff')) {
                  // Reindirizza a /admin se è admin/staff
                  window.location.replace('/admin');
                }
              });
          }
        });
      }
    });
  }
</script>

<style>
  .account-page {
    min-height: 80vh;
    padding: 2rem 1rem;
    padding-top: calc(95px + 2rem); /* Header height + padding */
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-title {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .account-page {
      padding-top: calc(95px + 1rem);
    }
  }
</style>
