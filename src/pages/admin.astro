---
import Layout from '../layouts/Layout.astro';
import AuthGate from '../components/loyalty/AuthGate';
import AdminPanel from '../components/loyalty/AdminPanel';
---

<Layout title="Area Staff | Bar Chantilly">
  <main class="admin-page">
    <div class="container">
      <h1 class="page-title">Area Staff - Tessera Fedeltà</h1>
      <AuthGate requireRole="staff" client:load>
        <div class="admin-content">
          <AdminPanel client:load />
        </div>
      </AuthGate>
    </div>
  </main>
</Layout>

<style>
  .admin-page {
    min-height: 80vh;
    padding: 2rem 1rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-title {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 2rem;
    color: var(--color-text-primary);
  }

  .admin-content {
    margin-top: 2rem;
  }
</style>
